Project erp_platform_db {
  database_type: 'PostgreSQL'
  Note: '''
    ERP Platform — to'liq DB schema
    Manba: ERP Platform PRD v1.1 (bo'lim 1-7) + Biznes Qoidalari Aniqliklari (bo'lim 8)
    Domainlar: Auth/RBAC, Geography, CRM/Stores, Catalog, Promotions,
    Warehouse/Inventory, Orders, Finance, HR
    dbdiagram.io'ga to'g'ridan-to'g'ri joylashtirish uchun tayyor.
  '''
}

//////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////

Enum permission_action {
  READ
  CREATE
  UPDATE
  DELETE
  APPROVE
  CANCEL
  EXPORT
}

Enum order_status {
  NEW
  INVOICE_CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  PARTIAL_RETURN
  FULL_RETURN
  CANCELLED
}

Enum stock_movement_type {
  PURCHASE
  SALE
  RETURN
  WRITE_OFF
  ADJUSTMENT
  TRANSFER
}

Enum discount_type {
  PERCENTAGE
  FIXED_AMOUNT
  QUANTITY
  FREE_ITEM
  GIFT
  BUNDLE
}

Enum ledger_entry_type {
  DELIVERY
  PAYMENT
  RETURN
  ADJUSTMENT
}

Enum payment_method {
  CASH
  BANK_TRANSFER
}

Enum attendance_status {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

Enum sync_status {
  PENDING
  SYNCED
  FAILED
}

Enum doc_status {
  DRAFT
  CONFIRMED
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
}

//////////////////////////////////////////////
// CORE / MULTI-TENANCY (PRD 8.22)
//////////////////////////////////////////////

Table companies {
  id uuid [pk]
  name varchar
  is_active boolean [default: true]
  created_at timestamp

  Note: 'MVP: bitta yozuv (single-tenant). 3-bosqichda haqiqiy multi-tenancy uchun tayyor.'
}

//////////////////////////////////////////////
// AUTH / RBAC (PRD 2.1, 8.1, 8.2)
//////////////////////////////////////////////

Table users {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  phone varchar [unique]
  email varchar [unique]
  password_hash varchar
  is_active boolean [default: true]
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table employees {
  id uuid [pk]
  user_id uuid [ref: - users.id]
  company_id uuid [ref: > companies.id]
  full_name varchar
  phone varchar
  department varchar
  hired_at date
  passport_file_url varchar
  is_active boolean [default: true]
  created_at timestamp
  deleted_at timestamp

  Note: 'User (auth) 1:1 Employee (HR profili). PRD 8.1'
}

Table roles {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  is_system boolean [default: false]
  created_at timestamp
}

Table permissions {
  id uuid [pk]
  module varchar // stores, products, orders, warehouse, finance, hr, promotions
  action permission_action
}

Table role_permissions {
  id uuid [pk]
  role_id uuid [ref: > roles.id]
  permission_id uuid [ref: > permissions.id]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table user_roles {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  role_id uuid [ref: > roles.id]

  indexes {
    (employee_id, role_id) [unique]
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  token varchar [unique]
  expires_at timestamp
  created_at timestamp
}

Table audit_logs {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  action varchar
  entity_type varchar
  entity_id uuid
  old_value json
  new_value json
  ip_address varchar
  user_agent varchar
  created_at timestamp

  Note: 'Immutable. PRD 8.21'
}

//////////////////////////////////////////////
// GEOGRAPHY (PRD 8.23)
//////////////////////////////////////////////

Table regions {
  id uuid [pk]
  name varchar
}

Table districts {
  id uuid [pk]
  region_id uuid [ref: > regions.id]
  name varchar
}

//////////////////////////////////////////////
// CRM / STORES (PRD 2.2, 8.3, 8.4, 8.5)
//////////////////////////////////////////////

Table price_groups {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar // standard, ulgurji, VIP
  created_at timestamp
}

Table stores {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  address varchar
  region_id uuid [ref: > regions.id]
  district_id uuid [ref: > districts.id]
  customer_type varchar // RETAIL, WHOLESALE, PHARMACY... (PRD 8.3)
  responsible_name varchar
  responsible_phone varchar
  latitude decimal
  longitude decimal
  default_warehouse_id uuid [ref: > warehouses.id]
  price_group_id uuid [ref: > price_groups.id]
  is_active boolean [default: true]
  created_at timestamp
  deleted_at timestamp

  Note: 'default_warehouse_id o\'zgaruvchan; buyurtmadagi haqiqiy ombor orders.warehouse_id da snapshot qilinadi (PRD 8.5)'
}

Table store_agent_assignments {
  id uuid [pk]
  store_id uuid [ref: > stores.id]
  agent_id uuid [ref: > employees.id]
  assigned_from timestamp
  assigned_to timestamp
  is_current boolean [default: true]

  indexes {
    (store_id, is_current)
  }

  Note: 'Do\'kon-agent tarixi. Bitta store uchun faqat 1 ta is_current=true (PRD 8.4)'
}

//////////////////////////////////////////////
// CATALOG (PRD 2.3, 8.7, 8.8)
//////////////////////////////////////////////

Table categories {
  id uuid [pk]
  parent_id uuid [ref: > categories.id]
  name varchar

  Note: 'Self-referencing daraxt strukturasi (PRD 8.7)'
}

Table currencies {
  code varchar [pk] // UZS, USD
  name varchar
}

Table currency_rates {
  id uuid [pk]
  currency_code varchar [ref: > currencies.code]
  rate decimal
  effective_date date
  created_by uuid [ref: > users.id]

  indexes {
    (currency_code, effective_date) [unique]
  }
}

Table products {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  category_id uuid [ref: > categories.id]
  name varchar
  sku varchar [unique]
  barcode varchar
  unit varchar // dona, kg, litr, quti
  description text
  image_url varchar
  is_active boolean [default: true]
  min_stock_level decimal
  created_at timestamp
  deleted_at timestamp
}

Table product_prices {
  id uuid [pk]
  product_id uuid [ref: > products.id]
  price_group_id uuid [ref: > price_groups.id]
  price decimal
  currency_code varchar [ref: > currencies.code]
  effective_from timestamp
  effective_to timestamp

  indexes {
    (product_id, price_group_id, effective_from)
  }

  Note: 'Joriy narx = effective_to NULL bo\'lgan yozuv (PRD 8.8)'
}

//////////////////////////////////////////////
// PROMOTIONS (PRD 2.4, 8.9)
//////////////////////////////////////////////

Table promotions {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  discount_type discount_type
  discount_value decimal
  max_discount_percent decimal
  priority int
  is_exclusive boolean [default: false]
  store_category_scope varchar // ALL, WHOLESALE_ONLY, ...
  starts_at date
  ends_at date
  is_active boolean [default: true]
  created_at timestamp
}

Table promotion_products {
  id uuid [pk]
  promotion_id uuid [ref: > promotions.id]
  product_id uuid [ref: > products.id]
}

//////////////////////////////////////////////
// WAREHOUSE / INVENTORY (PRD 2.7, 8.5, 8.6, 8.15, 8.16)
//////////////////////////////////////////////

Table warehouses {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  address varchar
  region_id uuid [ref: > regions.id]
  responsible_employee_id uuid [ref: > employees.id]
  is_active boolean [default: true]
  created_at timestamp
}

Table warehouse_stocks {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  product_id uuid [ref: > products.id]
  quantity decimal
  minimum_quantity decimal

  indexes {
    (warehouse_id, product_id) [unique]
  }

  Note: 'Joriy qoldiq. Tarix uchun stock_movements ga qarang.'
}

Table suppliers {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  contact_person varchar
  phone varchar
  address varchar
  created_at timestamp
}

Table stock_movements {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  product_id uuid [ref: > products.id]
  type stock_movement_type
  quantity decimal
  reference_type varchar // PURCHASE, ORDER, RETURN, WRITE_OFF, INVENTORY_ADJUSTMENT, TRANSFER
  reference_id uuid
  created_by uuid [ref: > users.id]
  created_at timestamp

  Note: 'Immutable harakatlar jurnali (PRD 8.15)'
}

Table purchases {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  supplier_id uuid [ref: > suppliers.id]
  status doc_status
  created_by uuid [ref: > users.id]
  confirmed_by uuid [ref: > users.id]
  created_at timestamp
  confirmed_at timestamp

  Note: 'Kirim/Prixod: 2 bosqichli tasdiqlash (PRD 2.7.2)'
}

Table purchase_items {
  id uuid [pk]
  purchase_id uuid [ref: > purchases.id]
  product_id uuid [ref: > products.id]
  quantity decimal
  unit_price decimal
  currency_code varchar [ref: > currencies.code]
}

Table warehouse_transfers {
  id uuid [pk]
  from_warehouse_id uuid [ref: > warehouses.id]
  to_warehouse_id uuid [ref: > warehouses.id]
  product_id uuid [ref: > products.id]
  quantity decimal
  status doc_status
  created_by uuid [ref: > users.id]
  created_at timestamp

  Note: '2-bosqich funksiyasi, schema MVP dan tayyor (PRD 8.6)'
}

Table write_offs {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  product_id uuid [ref: > products.id]
  quantity decimal
  reason text [not null]
  status doc_status
  created_by uuid [ref: > users.id]
  approved_by uuid [ref: > users.id]
  created_at timestamp
  approved_at timestamp

  Note: 'Spisaniye: omborchi kiritadi, admin tasdiqlaydi (PRD 2.7.5)'
}

Table inventory_counts {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  status doc_status
  created_by uuid [ref: > users.id]
  created_at timestamp
}

Table inventory_count_items {
  id uuid [pk]
  inventory_count_id uuid [ref: > inventory_counts.id]
  product_id uuid [ref: > products.id]
  system_quantity decimal
  actual_quantity decimal
  difference decimal

  Note: 'Tasdiqlanguncha "pending" ADJUSTMENT stock_movement yaratadi (PRD 8.16)'
}

//////////////////////////////////////////////
// ORDERS (PRD 2.5, 2.6, 8.10, 8.11, 8.12, 8.19)
//////////////////////////////////////////////

Table visits {
  id uuid [pk]
  store_id uuid [ref: > stores.id]
  agent_id uuid [ref: > employees.id]
  visited_at timestamp
  latitude decimal
  longitude decimal
  distance_meters decimal
  is_valid boolean
  note text

  Note: 'is_valid = distance_meters <= 100m (sozlanuvchi, PRD 8.18)'
}

Table orders {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  store_id uuid [ref: > stores.id]
  agent_id uuid [ref: > employees.id]
  visit_id uuid [ref: > visits.id]
  warehouse_id uuid [ref: > warehouses.id]
  status order_status
  currency_code varchar [ref: > currencies.code]
  exchange_rate decimal
  total_amount decimal
  note varchar
  client_generated_id uuid [unique]
  sync_status sync_status
  created_at timestamp
  updated_at timestamp

  Note: 'warehouse_id — yaratilish paytidagi snapshot (PRD 8.5). client_generated_id — offline idempotency (PRD 8.19). Tasdiqlangach o\'chirilmaydi, faqat status orqali vozvrat/bekor qilinadi.'
}

Table order_status_history {
  id uuid [pk]
  order_id uuid [ref: > orders.id]
  from_status order_status
  to_status order_status
  changed_by uuid [ref: > users.id]
  changed_at timestamp

  Note: 'Faqat PRD 8.10 dagi ruxsat etilgan o\'tishlar amalga oshiriladi'
}

Table order_items {
  id uuid [pk]
  order_id uuid [ref: > orders.id]
  product_id uuid [ref: > products.id]
  quantity decimal
  unit_price decimal
  currency_code varchar [ref: > currencies.code]
  exchange_rate decimal
  discount_amount decimal
  returned_quantity decimal [default: 0]
  total decimal

  Note: 'unit_price/currency/exchange_rate — zakaz vaqtidagi snapshot. returned_quantity <= quantity constraint (PRD 8.12)'
}

Table invoices {
  id uuid [pk]
  order_id uuid [ref: > orders.id]
  invoice_number varchar [unique]
  deliveryman_id uuid [ref: > employees.id]
  pdf_url varchar
  created_by uuid [ref: > users.id]
  created_at timestamp

  Note: 'Nakladnoy. Order 1—N Invoice qo\'llab-quvvatlanadi, MVP da 1:1 (PRD 8.11)'
}

Table schet_fakturas {
  id uuid [pk]
  invoice_id uuid [ref: > invoices.id]
  number varchar [unique]
  pdf_url varchar
  created_at timestamp

  Note: 'Order -> Invoice -> SchetFaktura zanjiri (PRD 8.11)'
}

Table deliveries {
  id uuid [pk]
  order_id uuid [ref: > orders.id]
  deliveryman_id uuid [ref: > employees.id]
  status varchar // PICKED_UP, IN_TRANSIT, DELIVERED
  delivered_latitude decimal
  delivered_longitude decimal
  note text
  updated_at timestamp
}

Table returns {
  id uuid [pk]
  order_id uuid [ref: > orders.id]
  reason text [not null]
  type varchar // PARTIAL, FULL
  created_by uuid [ref: > users.id]
  created_at timestamp
}

Table return_items {
  id uuid [pk]
  return_id uuid [ref: > returns.id]
  order_item_id uuid [ref: > order_items.id]
  quantity decimal
  amount decimal
}

//////////////////////////////////////////////
// FINANCE (PRD 2.8, 8.13, 8.14)
//////////////////////////////////////////////

Table financial_transactions {
  id uuid [pk]
  store_id uuid [ref: > stores.id]
  type ledger_entry_type
  amount decimal
  currency_code varchar [ref: > currencies.code]
  reference_type varchar // ORDER, PAYMENT, RETURN, ADJUSTMENT
  reference_id uuid
  created_at timestamp

  Note: 'Ledger. Do\'kon qarzdorligi shu yozuvlar yig\'indisidan hisoblanadi (PRD 8.13). UZS/USD alohida yuritiladi (PRD 8.14)'
}

Table payments {
  id uuid [pk]
  store_id uuid [ref: > stores.id]
  invoice_id uuid [ref: > invoices.id]
  method payment_method
  amount decimal
  currency_code varchar [ref: > currencies.code]
  received_by uuid [ref: > users.id]
  received_at timestamp

  Note: 'invoice_id NULL bo\'lsa — avans. Aks holda FIFO/qo\'lda allocation (PRD 8.14)'
}

//////////////////////////////////////////////
// HR (PRD 2.9, 8.17, 8.18)
//////////////////////////////////////////////

Table attendance {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  date date
  status attendance_status
  first_login_at timestamp
  visit_confirmed_at timestamp
  marked_by uuid [ref: > users.id]

  indexes {
    (employee_id, date) [unique]
  }

  Note: 'PRESENT faqat birinchi GPS visit tasdiqlangach belgilanadi (PRD 8.18)'
}

Table kpi_indicators {
  id uuid [pk]
  role_id uuid [ref: > roles.id]
  name varchar
  weight decimal
}

Table employee_kpi_scores {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  kpi_indicator_id uuid [ref: > kpi_indicators.id]
  period varchar // masalan 2026-09
  target_value decimal
  actual_value decimal
  achievement_percent decimal
  score decimal

  Note: 'score = min(actual/target,100%) x weight (PRD 8.17)'
}

Table targets {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  period varchar
  sales_target decimal
  currency_code varchar [ref: > currencies.code]
}

Table bonus_rules {
  id uuid [pk]
  company_id uuid [ref: > companies.id]
  name varchar
  condition_description text
  bonus_amount decimal
}

Table bonuses {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  bonus_rule_id uuid [ref: > bonus_rules.id]
  amount decimal
  period varchar
  type varchar // MANUAL, AUTOMATIC
  created_by uuid [ref: > users.id]
  created_at timestamp

  Note: 'Faqat net sales asosida hisoblanadi (PRD 8.17)'
}

Table salaries {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  period varchar
  base_amount decimal
  bonus_amount decimal
  kpi_amount decimal
  deductions decimal
  net_amount decimal
  generated_at timestamp
}

//////////////////////////////////////////////
// TABLE GROUPS
//////////////////////////////////////////////

TableGroup g_auth_rbac {
  users
  employees
  roles
  permissions
  role_permissions
  user_roles
  refresh_tokens
  audit_logs
}

TableGroup g_geography {
  regions
  districts
}

TableGroup g_crm {
  price_groups
  stores
  store_agent_assignments
}

TableGroup g_catalog {
  categories
  currencies
  currency_rates
  products
  product_prices
}

TableGroup g_promotions {
  promotions
  promotion_products
}

TableGroup g_warehouse {
  warehouses
  warehouse_stocks
  suppliers
  stock_movements
  purchases
  purchase_items
  warehouse_transfers
  write_offs
  inventory_counts
  inventory_count_items
}

TableGroup g_orders {
  visits
  orders
  order_status_history
  order_items
  invoices
  schet_fakturas
  deliveries
  returns
  return_items
}

TableGroup g_finance {
  financial_transactions
  payments
}

TableGroup g_hr {
  attendance
  kpi_indicators
  employee_kpi_scores
  targets
  bonus_rules
  bonuses
  salaries
}
